<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameTraps</AssemblyName>
    <RootNamespace>GameTraps</RootNamespace>
    <Version>1.4.0</Version>
    <Product>GameTraps</Product>
    <Description>Traps for GTA V free roam (scooters, ramps, hunting animals, falling planes, aliens and more), triggered through a public API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\config.json" />
    <None Include="data\config.json" Link="GameTraps\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
