<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MissionLauncher</AssemblyName>
    <RootNamespace>MissionLauncher</RootNamespace>
    <Version>1.5.0</Version>
    <Product>MissionLauncher</Product>
    <Description>Replay any GTA V story mission or Strangers and Freaks mission, with a public API reporting results.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="data\stat_labels.json" LogicalName="MissionLauncher.stat_labels.json" />
    <EmbeddedResource Include="data\missions.json" LogicalName="MissionLauncher.missions.json" />
    <None Remove="data\config.json" />
    <None Include="data\config.json" Link="MissionLauncher\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
