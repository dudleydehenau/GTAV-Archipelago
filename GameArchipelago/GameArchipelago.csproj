<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameArchipelago</AssemblyName>
    <RootNamespace>GameArchipelago</RootNamespace>
    <Version>1.7.4</Version>
    <Product>GameArchipelago</Product>
    <Description>Archipelago multiworld client for GTA V story mode: connects to the server, applies the items and sends the checks of the GTA V Archipelago mods.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionLauncher" Condition="Exists('lib\MissionLauncher.dll')">
      <HintPath>lib\MissionLauncher.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionLauncher" Condition="!Exists('lib\MissionLauncher.dll')">
      <HintPath>..\MissionLauncher\bin\$(Configuration)\net48\MissionLauncher.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameEnvironment" Condition="Exists('lib\GameEnvironment.dll')">
      <HintPath>lib\GameEnvironment.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameEnvironment" Condition="!Exists('lib\GameEnvironment.dll')">
      <HintPath>..\GameEnvironment\bin\$(Configuration)\net48\GameEnvironment.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameTraps" Condition="Exists('lib\GameTraps.dll')">
      <HintPath>lib\GameTraps.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameTraps" Condition="!Exists('lib\GameTraps.dll')">
      <HintPath>..\GameTraps\bin\$(Configuration)\net48\GameTraps.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameCollectibles" Condition="Exists('lib\GameCollectibles.dll')">
      <HintPath>lib\GameCollectibles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameCollectibles" Condition="!Exists('lib\GameCollectibles.dll')">
      <HintPath>..\GameCollectibles\bin\$(Configuration)\net48\GameCollectibles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\config.json" />
    <None Remove="data\vehicles.json" />
    <None Remove="data\weapons.json" />
    <None Include="data\config.json" Link="GameArchipelago\config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\vehicles.json" Link="GameArchipelago\vehicles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\weapons.json" Link="GameArchipelago\weapons.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
