<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameCollectibles</AssemblyName>
    <RootNamespace>GameCollectibles</RootNamespace>
    <Version>1.1.0</Version>
    <Product>GameCollectibles</Product>
    <Description>Every GTA V story collectible replaced by one 3D object that can be picked up from the start, each pickup reported through a public API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\config.json" />
    <None Include="data\config.json" Link="GameCollectibles\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
