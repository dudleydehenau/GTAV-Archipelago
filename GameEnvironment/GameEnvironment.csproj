<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameEnvironment</AssemblyName>
    <RootNamespace>GameEnvironment</RootNamespace>
    <Version>1.6.8</Version>
    <Product>GameEnvironment</Product>
    <Description>Sterile free-roam start for GTA V: three characters, no story triggers, character locks, money, weapons and vehicles driven by a public API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionLauncher" Condition="Exists('lib\MissionLauncher.dll')">
      <HintPath>lib\MissionLauncher.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionLauncher" Condition="!Exists('lib\MissionLauncher.dll')">
      <HintPath>..\MissionLauncher\bin\$(Configuration)\net48\MissionLauncher.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\config.json" />
    <None Include="data\config.json" Link="GameEnvironment\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
